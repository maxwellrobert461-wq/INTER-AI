{
  "app": {
    "name": "INTER AI",
    "tagline": "Like Meta AI that builds apps, websites, images — then auto-installs & hosts",
    "version": "2.0.0",
    "url": "https://inter-ai.vercel.app",
    "stack": ["GitHub", "Vercel", "Vercel Blob", "Groq API"],
    "no_supabase": true
  },
  "founder": {
    "name": "Odera Chidalu Vitalis Vitalis",
    "hidden_in_ui": true,
    "show_when_asked": ["who built", "who created", "founder", "who owns", "who made"],
    "country": "Nigeria",
    "contact": "hidden"
  },
  "auth": {
    "required": true,
    "method": "Email + ID Card",
    "id_types": ["NIN", "Driver License", "Voter Card", "Passport"],
    "storage": "Vercel Blob (private, encrypted)",
    "compliance": "NDPA Nigeria"
  },
  "pricing": {
    "currency": "NGN",
    "with_domain": {
      "monthly": 20000,
      "yearly": 150000,
      "includes": ["1 free .com domain", "hosting", "unlimited builds", "SSL"]
    },
    "own_domain": {
      "monthly": 10000,
      "yearly": 80000,
      "includes": ["hosting only", "unlimited builds", "SSL", "connect external domain"]
    },
    "domain_only": {
      ".com": 12000,
      ".com.ng": 8500,
      ".ng": 22000,
      ".app": 30000,
      ".io": 30000
    },
    "free_tier": {
      "builds": 3,
      "hosting": false
    }
  },
  "features": {
    "chat": true,
    "build_apps": true,
    "build_websites": true,
    "generate_images": true,
    "auto_install": {
      "enabled": true,
      "type": "PWA - Add to Home Screen",
      "prompt": "beforeinstallprompt"
    },
    "auto_host": {
      "enabled": true,
      "via": "Vercel Blob - public HTML"
    },
    "buy_domain": true,
    "check_domain": true
  },
  "files": {
    "core": ["pages/index.js", "pages/_document.js", "pages/register.js", "pages/domains.js", "pages/settings.js"],
    "api": ["api/chat.js", "api/build.js", "api/register.js", "api/check-domain.js", "api/buy-domain.js", "api/auto-install.js"],
    "public": ["manifest.json", "sw.js", "profile.json"]
  }
}